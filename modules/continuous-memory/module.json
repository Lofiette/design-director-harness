{
  "module_id": "continuous-memory",
  "version": "0.1.0",
  "implementation": "stdlib Python CLI",
  "status": "experimental_local_kernel",
  "host_neutral": true,
  "minimum_python": "3.10",
  "runtime_registration": "kernel_in_project_install_on_sim_opt_in",
  "automatic_host_capture": false,
  "automatic_publication": false,
  "automatic_skill_installation": false,
  "automatic_hidden_model_change_detection": false,
  "contracts": [
    "contracts/memory-event.schema.json",
    "contracts/environment-fingerprint.schema.json",
    "contracts/skill-registry.schema.json"
  ],
  "entrypoints": {
    "memory_kernel": "ddh_memory.py",
    "sim": "sim.py",
    "session_context": "context_pack.py"
  },
  "session_context": {
    "version": "0.1.0",
    "scope": "explicit_pinned_source_pack",
    "documentation": "README.context-pack.md",
    "native_host_installation": false
  }
}
