{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ddh:skill-registry:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "const": "ddh-skill-registry/1"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill_id",
          "owner",
          "status",
          "revision",
          "workflow_keys"
        ],
        "properties": {
          "skill_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,180}$"
          },
          "owner": {
            "enum": [
              "profile",
              "toolkit",
              "identity"
            ]
          },
          "status": {
            "enum": [
              "active",
              "candidate",
              "retired"
            ]
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "workflow_keys": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
